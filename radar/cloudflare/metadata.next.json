{
  "main_module": "worker.js",
  "compatibility_date": "2026-11-01",
  "bindings": [
    {
      "type": "durable_object_namespace",
      "name": "RADAR",
      "class_name": "RadarSnapshot"
    }
  ],
  "migrations": {
    "old_tag": "v1",
    "new_tag": "v1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": { "enabled": true, "head_sampling_rate": 0.01, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
